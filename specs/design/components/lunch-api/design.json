{
  "name": "lunch-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "lunch-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F2.5",
    "F2.6",
    "F2.7",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4",
    "F4.1",
    "F4.2",
    "F4.3",
    "F4.4",
    "F4.5"
  ],
  "description": "The single backend for the lunch order. It owns today's menu (items, publishing, closing) and every person's order, enforces the rules (one order per person, edits only while ordering is open, no reopening) and answers the web app. It is reached by the browser through the gateway, so it is internet-exposed and protected by sign-in. It does not render UI and holds no identity data beyond the signed-in person's id and display name.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "lunch-order-l29-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "lunch-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "lunch-order-l29-lunch-db",
        "envBindings": {
          "dbname": "LUNCH_DB_DBNAME",
          "host": "LUNCH_DB_HOST",
          "password": "LUNCH_DB_PASSWORD",
          "port": "LUNCH_DB_PORT",
          "user": "LUNCH_DB_USER"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
