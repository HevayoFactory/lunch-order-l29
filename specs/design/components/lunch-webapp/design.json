  ],
  "description": "The one browser app for both roles: staff see today's menu and place, change or cancel their order; the office manager builds, publishes and closes the menu and sees the order list. Users sign in through the platform SSO. A separate surface per role is not justified, since both share one menu and one lifecycle. It holds no data of its own and calls only lunch-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "lunch-api",
      "wiring": {
        "endpoint": {
          "component": "lunch-order-l29-lunch-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "LUNCH_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "lunch-order-l29-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
